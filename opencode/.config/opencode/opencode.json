{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "ask",
          "git *": "allow",
          "git commit*": "ask",
          "git push*": "ask",
          "npm *": "allow",
          "npm install*": "ask",
          "npm i*": "ask",
          "npm run*": "ask",
          "pnpm *": "allow",
          "pnpm install*": "ask",
          "pnpm i*": "ask",
          "pnpm run*": "ask",
          "yarn *": "allow",
          "yarn install*": "ask",
          "yarn add*": "ask",
          "cargo *": "allow",
          "make *": "allow",
          "ls *": "allow",
          "ls": "allow",
          "cat *": "allow",
          "find *": "allow",
          "find": "allow",
          "grep *": "allow",
          "echo *": "allow",
          "head *": "allow",
          "head": "allow",
          "tail *": "allow",
          "tail": "allow",
          "mkdir *": "allow",
          "mkdir": "allow",
          "wc *": "allow",
          "curl *": "allow",
          "wget *": "allow",
          "mvn": "allow",
          "mvn *": "allow",
          "rm *": "deny",
          "rmdir *": "deny",
          "sudo *": "deny"
        },
        "read": {
          "*": "allow",
          "**/.env*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny",
          "**/id_ed25519*": "deny",
          "**/.ssh/**": "deny",
          "**/*credentials*": "deny",
          "**/*secret*": "deny",
          "**/.aws/**": "deny",
          "**/.npmrc": "deny",
          "**/.gitconfig": "deny",
          "**/.netrc": "deny",
          "**/*.p12": "deny",
          "**/*.pfx": "deny",
          "**/htpasswd*": "deny",
          "**/kubeconfig*": "deny",
          "**/*password*": "deny",
          "**/.docker/config.json": "deny",
          "**/terraform.tfvars*": "deny",
          "**/*token*": "deny"
        },
        "edit": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "external_directory": {
          "*": "ask"
        }
      }
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.2",                 // daily driver — community "safe choice," most popular
  "small_model": "opencode-go/mimo-v2.5", // titles & lightweight housekeeping (zero-retention, no training)
  "compaction": { "auto": true, "prune": true, "reserved": 10000 },
  "lsp": true,
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "ask",
          "git *": "allow",
          "git commit*": "ask",
          "git push*": "ask",
          "npm *": "allow",
          "npm install*": "ask",
          "npm i*": "ask",
          "npm run*": "ask",
          "pnpm *": "allow",
          "pnpm install*": "ask",
          "pnpm i*": "ask",
          "pnpm run*": "ask",
          "yarn *": "allow",
          "yarn install*": "ask",
          "yarn add*": "ask",
          "cargo *": "allow",
          "make *": "allow",
          "ls *": "allow",
          "ls": "allow",
          "cat *": "allow",
          "find *": "allow",
          "find": "allow",
          "grep *": "allow",
          "echo *": "allow",
          "head *": "allow",
          "head": "allow",
          "tail *": "allow",
          "tail": "allow",
          "mkdir *": "allow",
          "mkdir": "allow",
          "wc *": "allow",
          "curl *": "allow",
          "wget *": "allow",
          "mvn": "allow",
          "mvn *": "allow",
          "rm *": "deny",
          "rmdir *": "deny",
          "sudo *": "deny"
        },
        "read": {
          "*": "allow",
          "**/.env*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny",
          "**/id_ed25519*": "deny",
          "**/.ssh/**": "deny",
          "**/*credentials*": "deny",
          "**/*secret*": "deny",
          "**/.aws/**": "deny",
          "**/.npmrc": "deny",
          "**/.gitconfig": "deny",
          "**/.netrc": "deny",
          "**/*.p12": "deny",
          "**/*.pfx": "deny",
          "**/htpasswd*": "deny",
          "**/kubeconfig*": "deny",
          "**/*password*": "deny",
          "**/.docker/config.json": "deny",
          "**/terraform.tfvars*": "deny",
          "**/*token*": "deny"
        },
        "edit": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "external_directory": {
          "*": "ask"
        }
      }
    },
    "plan":       { "model": "opencode-go/qwen3.7-max" },    // #1 on Go (60.6% SWE-Pro) — deep planning
    "explore":    { "model": "opencode-go/mimo-v2.5" },     // 30.1K req/5hr, never rate-limited
    "general":    { "model": "opencode-go/deepseek-v4-pro" }, // 1M ctx, 80.6% SWE-Verified, ~3x cheaper than GLM
    "scout":      { "model": "opencode-go/mimo-v2.5" },     // external docs research
    "compaction": { "model": "opencode-go/mimo-v2.5" },    // hidden — sees whole context, cheapest
    "title":      { "model": "opencode-go/mimo-v2.5" },     // hidden
    "summary":    { "model": "opencode-go/mimo-v2.5" }      // hidden
  }
}